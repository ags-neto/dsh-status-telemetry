{
  "name": "@local/dsh-status-telemetry",
  "version": "1.0.0",
  "private": true,
  "description": "Rich session status and telemetry for the DSH composer dock.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ags-neto/dsh-status-telemetry.git"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
